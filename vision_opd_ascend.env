# Vision-OPD Ascend lifecycle configuration.
#
# This file is sourced with automatic export by start_vision_opd_ascend.sh.
# A value already injected by Huawei/ModelArts has priority because every entry
# uses ${VARIABLE:-default}. User-defined variables intentionally use VOPD_
# instead of the platform-reserved MA_ prefix.

# Lifecycle controls. Dependencies are created on the NPU worker in an
# isolated venv. "auto" reuses it when requirements-ascend.txt is unchanged.
VOPD_INSTALL_MODE="${VOPD_INSTALL_MODE:-auto}"
VOPD_RUN_MODE="${VOPD_RUN_MODE:-train}"
VOPD_PREPARE_DATA_IF_MISSING="${VOPD_PREPARE_DATA_IF_MISSING:-1}"
VOPD_AUTO_MERGE="${VOPD_AUTO_MERGE:-1}"
VOPD_SINGLE_DRIVER_GUARD="${VOPD_SINGLE_DRIVER_GUARD:-1}"
VOPD_RESUME_MODE="${VOPD_RESUME_MODE:-auto}"
VOPD_RESUME_FROM_PATH="${VOPD_RESUME_FROM_PATH:-null}"

# Portable project assets. Every relative path is resolved from the Vision-OPD
# repository, never from ModelArts' algorithm launch directory.
VOPD_ASSET_ROOT="${VOPD_ASSET_ROOT:-envs}"

# Runtime profile. The official vLLM-Ascend 0.18.0 Atlas A2 release supports
# CPython 3.10 and 3.11. "auto" selects an installed interpreter that has a
# matching offline wheelhouse; explicit platform values still take priority.
VOPD_STACK_PROFILE="${VOPD_STACK_PROFILE:-vllm-ascend-0.18-cann8.5.1}"
VOPD_SUPPORTED_PYTHONS="${VOPD_SUPPORTED_PYTHONS:-3.11 3.10}"
VOPD_TARGET_PYTHON="${VOPD_TARGET_PYTHON:-auto}"
VOPD_PREPARE_TARGET_PYTHON="${VOPD_PREPARE_TARGET_PYTHON:-3.11}"
VOPD_WHEEL_ROOT="${VOPD_WHEEL_ROOT:-${VOPD_ASSET_ROOT}/wheels}"
VOPD_RUNTIME_ROOT="${VOPD_RUNTIME_ROOT:-${VOPD_ASSET_ROOT}/runtime}"
# Empty means derive cp310/cp311 paths from the selected worker interpreter.
VOPD_VENV_DIR="${VOPD_VENV_DIR:-}"
VOPD_ASCEND_REQUIREMENTS="${VOPD_ASCEND_REQUIREMENTS:-requirements-ascend.txt}"
VOPD_ASCEND_CORE_REQUIREMENTS="${VOPD_ASCEND_CORE_REQUIREMENTS:-requirements-ascend-core.txt}"
VOPD_ASCEND_PLUGIN_REQUIREMENTS="${VOPD_ASCEND_PLUGIN_REQUIREMENTS:-requirements-ascend-plugins.txt}"
VOPD_BOOTSTRAP_PYTHON="${VOPD_BOOTSTRAP_PYTHON:-}"
VOPD_LOCAL_WHEEL_DIR="${VOPD_LOCAL_WHEEL_DIR:-}"
# Production defaults to the same fully offline --no-index/--find-links model
# as the supplied Huawei sample. Online indexes are explicit opt-in overrides.
VOPD_PIP_INDEX_URL="${VOPD_PIP_INDEX_URL:-http://repo.myhuaweicloud.com/repository/pypi/simple}"
VOPD_PIP_EXTRA_INDEX_URL="${VOPD_PIP_EXTRA_INDEX_URL:-}"
VOPD_PIP_TRUSTED_HOST="${VOPD_PIP_TRUSTED_HOST:-repo.myhuaweicloud.com}"
VOPD_PIP_CONFIG_FILE="${VOPD_PIP_CONFIG_FILE:-/dev/null}"
VOPD_PIP_NO_INDEX="${VOPD_PIP_NO_INDEX:-1}"
VOPD_PIP_TIMEOUT="${VOPD_PIP_TIMEOUT:-120}"
VOPD_PIP_RETRIES="${VOPD_PIP_RETRIES:-5}"
VOPD_VLLM_ALLOW_SOURCE_FALLBACK="${VOPD_VLLM_ALLOW_SOURCE_FALLBACK:-0}"
VOPD_MIN_GLIBC="${VOPD_MIN_GLIBC:-2.31}"

# vLLM-Ascend 0.18.0's stable Atlas A2 matrix uses CANN 8.5.1. Platform-injected
# environment-script paths win, but the detected version must match this value.
# The explicit ZSH_VERSION workaround is applied by scripts/ascend_env.sh.
CANN_ENV_SCRIPT="${CANN_ENV_SCRIPT:-/usr/local/Ascend/ascend-toolkit/set_env.sh}"
NNAL_ENV_SCRIPT="${NNAL_ENV_SCRIPT:-/usr/local/Ascend/nnal/atb/set_env.sh}"
ASDSIP_ENV_SCRIPT="${ASDSIP_ENV_SCRIPT:-/usr/local/Ascend/nnal/asdsip/set_env.sh}"
VOPD_EXPECTED_CANN_VERSION="${VOPD_EXPECTED_CANN_VERSION:-8.5.1}"
VOPD_REQUIRE_CANN_VERSION_MATCH="${VOPD_REQUIRE_CANN_VERSION_MATCH:-1}"
VOPD_REQUIRE_ASDSIP="${VOPD_REQUIRE_ASDSIP:-0}"
VOPD_ENABLE_TEE_LOG="${VOPD_ENABLE_TEE_LOG:-1}"

# Portable asset preparation may run in x86_64/Python 3.9 WebStudio: pip is
# cross-targeted to VOPD_PREPARE_TARGET_PYTHON/aarch64. It stays offline unless --online or
# VOPD_PREPARE_ONLINE=1 is explicitly selected. The runtime venv is never
# prepared here; install_ascend.sh creates it on the real NPU worker.
VOPD_PREPARE_ONLINE="${VOPD_PREPARE_ONLINE:-0}"
VOPD_INTERNAL_WHEEL_DIRS="${VOPD_INTERNAL_WHEEL_DIRS:-}"
VOPD_MODEL_SOURCE_DIR="${VOPD_MODEL_SOURCE_DIR:-}"
VOPD_MODEL_REPO_ID="${VOPD_MODEL_REPO_ID:-Qwen/Qwen3.5-4B}"
# Immutable upstream revision used by the portable asset manifest. Override
# this only when intentionally moving to a different verified model snapshot.
VOPD_MODEL_REVISION="${VOPD_MODEL_REVISION:-c7429d5a8ed57f4a9cfdaf1af76a8943eba0ae97}"
VOPD_PREPARE_PIP_INDEX_URL="${VOPD_PREPARE_PIP_INDEX_URL:-${VOPD_PIP_INDEX_URL}}"
VOPD_PREPARE_PIP_EXTRA_INDEX_URL="${VOPD_PREPARE_PIP_EXTRA_INDEX_URL:-}"

# Model and mounted paths. Platform environment values override these defaults.
VOPD_MODEL_PATH="${VOPD_MODEL_PATH:-${VOPD_ASSET_ROOT}/models/Qwen3.5-4B}"
VOPD_REQUIRE_LOCAL_MODEL="${VOPD_REQUIRE_LOCAL_MODEL:-1}"
VOPD_HF_OFFLINE="${VOPD_HF_OFFLINE:-1}"
# Disable every optional telemetry path in the network-restricted worker.
DO_NOT_TRACK="${DO_NOT_TRACK:-1}"
HF_HUB_DISABLE_TELEMETRY="${HF_HUB_DISABLE_TELEMETRY:-1}"
VLLM_NO_USAGE_STATS="${VLLM_NO_USAGE_STATS:-1}"
RAY_USAGE_STATS_ENABLED="${RAY_USAGE_STATS_ENABLED:-0}"
VOPD_CACHE_DIR="${VOPD_CACHE_DIR:-${VOPD_ASSET_ROOT}/cache}"
HF_HOME="${HF_HOME:-${VOPD_CACHE_DIR}/huggingface}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-${VOPD_CACHE_DIR}/datasets}"
VLLM_CACHE_ROOT="${VLLM_CACHE_ROOT:-${VOPD_CACHE_DIR}/vllm}"
TORCH_HOME="${TORCH_HOME:-${VOPD_CACHE_DIR}/torch}"
PIP_CACHE_DIR="${PIP_CACHE_DIR:-${VOPD_CACHE_DIR}/pip}"
VOPD_DATA_DIR="${VOPD_DATA_DIR:-${PROJECT_ROOT}/data}"
VOPD_TRAIN_FILE="${VOPD_TRAIN_FILE:-${VOPD_DATA_DIR}/train.parquet}"
VOPD_OUTPUT_DIR="${VOPD_OUTPUT_DIR:-${MA_MOUNT_PATH:-${PROJECT_ROOT}}/output/vision-opd/checkpoints}"
VOPD_ROLLOUT_DIR="${VOPD_ROLLOUT_DIR:-${MA_MOUNT_PATH:-${PROJECT_ROOT}}/output/vision-opd/rollouts}"
VOPD_LOG_DIR="${VOPD_LOG_DIR:-${MA_LOG_DIR:-${PROJECT_ROOT}/output/vision-opd/logs}}"
VOPD_MERGED_MODEL_DIR="${VOPD_MERGED_MODEL_DIR:-${MA_MOUNT_PATH:-${PROJECT_ROOT}}/output/vision-opd/merged_model}"

# Experiment identity and tracking.
VOPD_PROJECT_NAME="${VOPD_PROJECT_NAME:-Vision-OPD}"
VOPD_EXPERIMENT_NAME="${VOPD_EXPERIMENT_NAME:-Vision-OPD-Qwen3.5-4B-Ascend}"
VOPD_LOGGER="${VOPD_LOGGER:-[\"console\",\"tensorboard\"]}"

# Paper optimization parameters.
VOPD_LR="${VOPD_LR:-2e-6}"
VOPD_LR_WARMUP_STEPS="${VOPD_LR_WARMUP_STEPS:-10}"
VOPD_TRAIN_BATCH_SIZE="${VOPD_TRAIN_BATCH_SIZE:-96}"
VOPD_PPO_MINI_BATCH_SIZE="${VOPD_PPO_MINI_BATCH_SIZE:-96}"
VOPD_TOTAL_EPOCHS="${VOPD_TOTAL_EPOCHS:-1}"
VOPD_TOTAL_TRAINING_STEPS="${VOPD_TOTAL_TRAINING_STEPS:-null}"
VOPD_ROLLOUT_N="${VOPD_ROLLOUT_N:-8}"
VOPD_ROLLOUT_ENGINE="${VOPD_ROLLOUT_ENGINE:-vllm}"
VOPD_DISTILL_ALPHA="${VOPD_DISTILL_ALPHA:-0.5}"
VOPD_DISTILL_TOPK="${VOPD_DISTILL_TOPK:-100}"
VOPD_TEACHER_UPDATE_RATE="${VOPD_TEACHER_UPDATE_RATE:-0.05}"

# Sequence and rollout limits.
VOPD_MAX_PROMPT_LENGTH="${VOPD_MAX_PROMPT_LENGTH:-8192}"
VOPD_MAX_RESPONSE_LENGTH="${VOPD_MAX_RESPONSE_LENGTH:-1024}"
VOPD_MAX_REPROMPT_LENGTH="${VOPD_MAX_REPROMPT_LENGTH:-10240}"
VOPD_ROLLOUT_TP_SIZE="${VOPD_ROLLOUT_TP_SIZE:-1}"
VOPD_ROLLOUT_MEMORY_UTILIZATION="${VOPD_ROLLOUT_MEMORY_UTILIZATION:-0.5}"

# Ascend resources. ModelArts variables are used when present.
VOPD_GPUS_PER_NODE="${VOPD_GPUS_PER_NODE:-${MA_NUM_GPUS:-${RANK_SIZE:-8}}}"
VOPD_NNODES="${VOPD_NNODES:-${MA_NUM_HOSTS:-1}}"
VOPD_MAX_TOKENS_PER_NPU="${VOPD_MAX_TOKENS_PER_NPU:-11264}"
VOPD_ACTOR_PARAM_OFFLOAD="${VOPD_ACTOR_PARAM_OFFLOAD:-True}"
VOPD_ACTOR_OPTIMIZER_OFFLOAD="${VOPD_ACTOR_OPTIMIZER_OFFLOAD:-True}"
VOPD_TEACHER_PARAM_OFFLOAD="${VOPD_TEACHER_PARAM_OFFLOAD:-True}"
VOPD_DATALOADER_WORKERS="${VOPD_DATALOADER_WORKERS:-8}"
VOPD_ROLLOUT_WORKERS="${VOPD_ROLLOUT_WORKERS:-8}"

# Checkpoint policy. The trainer always saves its final step; a positive save
# frequency additionally creates periodic recovery points.
VOPD_SAVE_FREQ="${VOPD_SAVE_FREQ:-20}"
VOPD_MAX_CHECKPOINTS="${VOPD_MAX_CHECKPOINTS:-3}"
