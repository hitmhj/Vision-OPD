# shellcheck shell=bash
# All paths are project-relative by default; platform environment variables may
# override any VOPD_* setting before this file is sourced.
: "${VOPD_PYTHON:=python3}"
: "${VOPD_MODEL_DIR:=${PROJECT_ROOT}/envs/models/Qwen3.5-4B}"
: "${VOPD_DATA_DIR:=${PROJECT_ROOT}/data}"
: "${VOPD_TRAIN_FILE:=${VOPD_DATA_DIR}/train.parquet}"
: "${VOPD_WHEELHOUSE:=${PROJECT_ROOT}/envs/wheels/cp311-aarch64}"
: "${VOPD_CACHE_DIR:=${PROJECT_ROOT}/envs/cache}"
: "${VOPD_RUNTIME_DIR:=${PROJECT_ROOT}/envs/runtime}"
: "${VOPD_OUTPUT_DIR:=${PROJECT_ROOT}/output}"
: "${VOPD_CHECKPOINT_DIR:=${VOPD_OUTPUT_DIR}/checkpoints/Vision-OPD-Qwen3.5-4B}"
: "${VOPD_ROLLOUT_DIR:=${VOPD_OUTPUT_DIR}/rollouts/Vision-OPD-Qwen3.5-4B}"
: "${VOPD_MERGED_DIR:=${VOPD_OUTPUT_DIR}/merged}"
: "${VOPD_LOG_DIR:=${VOPD_OUTPUT_DIR}/logs}"

: "${VOPD_INSTALL_DEPS:=0}"
: "${VOPD_DRY_RUN:=0}"
: "${VOPD_AUTO_MERGE:=0}"
: "${VOPD_ROLLOUT_BACKEND:=hf}"
: "${VOPD_NNODES:=${MA_NUM_HOSTS:-1}}"
: "${VOPD_NODE_RANK:=${VC_TASK_INDEX:-0}}"
: "${VOPD_NPUS_PER_NODE:=${MA_NUM_GPUS:-8}}"
: "${VOPD_MASTER_PORT:=6379}"
: "${VOPD_TRAIN_BATCH_SIZE:=32}"
: "${VOPD_PPO_MINI_BATCH_SIZE:=32}"
: "${VOPD_ROLLOUT_N:=8}"
: "${VOPD_MAX_PROMPT_LENGTH:=8192}"
: "${VOPD_MAX_RESPONSE_LENGTH:=1024}"
: "${VOPD_LR:=2e-6}"
: "${VOPD_TOTAL_EPOCHS:=1}"
: "${VOPD_TOTAL_TRAINING_STEPS:=-1}"
: "${VOPD_SAVE_FREQ:=50}"
: "${VOPD_MAX_CKPTS:=2}"
: "${VOPD_AGENT_WORKERS:=8}"
: "${VOPD_DATALOADER_WORKERS:=8}"
: "${VOPD_TEACHER_UPDATE_RATE:=0.05}"
: "${VOPD_RAY_ADDRESS:=}"

export VOPD_PYTHON VOPD_MODEL_DIR VOPD_DATA_DIR VOPD_TRAIN_FILE VOPD_WHEELHOUSE
export VOPD_CACHE_DIR VOPD_RUNTIME_DIR VOPD_OUTPUT_DIR VOPD_CHECKPOINT_DIR
export VOPD_ROLLOUT_DIR VOPD_MERGED_DIR VOPD_LOG_DIR VOPD_ROLLOUT_BACKEND
